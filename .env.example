# ==============================================================================
# NanoLabs AI Trading - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
TIMEZONE=America/Argentina/Buenos_Aires

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/live

# Bybit V5 Market Data (Public Linear)
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_DEFAULT_SYMBOL=BTCUSDT
BYBIT_CATEGORY=linear

# Database Persistence (PostgreSQL for Docker / Dedicated Server, SQLite for local testing)
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/trading.db
# When using PostgreSQL (e.g. in Docker Compose):
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=nanolabs_trading
# DB_USER=nanolabs_admin
# DB_PASSWORD=changeme_secure_trading_pwd

# Redis Cache / PubSub (Optional in local dev, enabled in Docker)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Provider API Keys (Leave empty until Phase 3)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ENABLED=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false

# Telegram Notifications (Leave empty until Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Operational Security
KILL_SWITCH_ACTIVE=false
TRADING_MODE=SIGNALS_ONLY
MAX_RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=1.5
MIN_RR_RATIO=4.0
